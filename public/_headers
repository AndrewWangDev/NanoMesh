# Cloudflare Pages / Static CDN Headers Fallback
# Note (NM-INFO-03): Under Cloudflare Workers Static Assets, dynamic response headers 
# injected by src/index.ts serve as the runtime Source of Truth.
/favicon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/apple-touch-icon*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/site.webmanifest
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
  Content-Type: application/manifest+json; charset=utf-8
  Access-Control-Allow-Origin: *
